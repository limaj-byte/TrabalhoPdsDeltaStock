@page "/venda/cadastro"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject VendaDAO dao

<PageTitle>
    Nova Venda - Delta Stock
</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Venda</h2>
    </div>
</div>

<div class="custom-table-card p-4">

    @if (MensagemErro is not null)
    {
        <div class="alert alert-danger" role="alert">
            @MensagemErro
        </div>
    }

    <EditForm Model="venda" OnValidSubmit="Salvar" FormName="venda-form">

        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">

            <div class="col-md-6">
                <label for="data" class="form-label">Data da Venda</label>

                <InputDate id="data"
                           class="form-control"
                           @bind-Value="venda.Dataven" />

                <ValidationMessage For="() => venda.Dataven" />
            </div>

            <div class="col-md-6">
                <label for="valor" class="form-label">Valor Total</label>

                <InputNumber id="valor"
                             class="form-control"
                             @bind-Value="venda.Valortotalven" />

                <ValidationMessage For="() => venda.Valortotalven" />
            </div>

        </div>

        <div class="row mb-3">

            <div class="col-md-6">
                <label for="status" class="form-label">Status</label>

                <InputText id="status"
                           class="form-control"
                           @bind-Value="venda.Statusven" />

                <ValidationMessage For="() => venda.Statusven" />
            </div>

            <div class="col-md-6">
                <label for="usuario" class="form-label">Usuário</label>

                <InputNumber id="usuario"
                             class="form-control"
                             @bind-Value="venda.Idusufk" />

                <ValidationMessage For="() => venda.Idusufk" />
            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Salvar
            </button>

            <a href="/Venda" class="btn btn-light border">
                Cancelar
            </a>

        </div>

    </EditForm>

</div>

@code {
    private DeltaStock.Models.Venda venda = new();
    private string? MensagemErro;

    private void Salvar()
    {
        try
        {
            dao.Inserir(venda);
            NavigationManager.NavigateTo("/Venda");
        }
        catch (Exception ex)
        {
            MensagemErro = $"Não foi possível salvar a venda. ({ex.Message})";
        }
    }
}