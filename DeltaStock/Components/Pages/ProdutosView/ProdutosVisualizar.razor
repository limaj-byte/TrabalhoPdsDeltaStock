@page "/ProdutosVisualizar"
@rendermode InteractiveServer
@inject ProdutoLocalStore ProdutoStore

<h1>Produtos</h1>

<div class="cards-container">
    @foreach (Produto produto in ProdutoStore.ObterTodos())
    {
        <div class="produto-card">
            <h3>@produto.Nome</h3>
            <p>Codigo: @produto.Codigo</p>
            <p>Fornecedor: @produto.Fornecedor</p>
            <p>Categoria: @produto.Categoria</p>
            <p>Estoque atual: @produto.Quantidade unidades</p>
            <p>Preco de compra: @produto.PrecoCompra.ToString("C")</p>
            <p>Preco sugerido: @produto.PrecoVenda.ToString("C")</p>

            <button type="button">Editar</button>
            <button type="button" @onclick="() => RemoverProduto(produto.Id)">Excluir</button>
        </div>
    }
</div>

@code {
    private void RemoverProduto(int id)
    {
        ProdutoStore.Remover(id);
    }
}
