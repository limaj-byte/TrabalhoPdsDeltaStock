@page "/Relatorios"

<PageTitle>Relatórios</PageTitle>

<div class="container mt-4">

    <h1>Relatórios</h1>

    <hr />
   
    <h3>Dashboard</h3>

    <div class="row">

        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <h5>Estoque Baixo</h5>
                <p>5 produtos</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <h5>Entradas Hoje</h5>
                <p>25 itens</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <h5>Saídas Hoje</h5>
                <p>18 itens</p>
            </div>
        </div>

    </div>

    <div class="row">

        <div class="col-md-6">
            <div class="card p-3 mb-3">
                <h5>Vendas do Período</h5>
                <p>R$ 2.500,00</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3 mb-3">
                <h5>Lucro Bruto</h5>
                <p>R$ 850,00</p>
            </div>
        </div>

    </div>

    <hr />
   
    <h3>Alertas</h3>

    <div class="alert alert-warning">
        Produto "Arroz 5kg" com estoque abaixo do mínimo.
    </div>

    <div class="alert alert-danger">
        Produto "Leite Integral" vence em 7 dias.
    </div>

    <hr />
    
    <h3>Exportação</h3>

    <button class="btn btn-success me-2">
        Exportar Estoque CSV
    </button>

    <button class="btn btn-primary">
        Exportar Financeiro CSV
    </button>

</div>
