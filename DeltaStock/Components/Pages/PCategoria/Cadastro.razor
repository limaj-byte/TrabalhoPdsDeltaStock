@page "/categoria/cadastro"
@page "/categoria/{Id:int?}/atualizacao"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CategoriaDAO dao


<PageTitle>
    @(Id.HasValue ? "Editar Categoria - Delta Stock" : "Nova Categoria - Delta Stock")
</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Categoria</h2>
    </div>
</div>

<div class="custom-table-card p-4">
    @if (MensagemErro is not null)
    {
        <div class="alert alert-danger" role="alert">@MensagemErro</div>
    }

    <EditForm Model="categoria" OnValidSubmit="Salvar" FormName="categoria-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">

            <div class="col-md-4">
                <label for="nome" class="form-label">Nome</label>
                <InputText id="nome" class="form-control" @bind-Value="categoria.Nome" />
                <ValidationMessage For="() => categoria.Nome" />
            </div>


            <div class="col-md-4">
                <label for="descricao" class="form-label">Descrição</label>
                <InputText id="descricao" class="form-control" @bind-Value="categoria.Descricao" maxlength="500" />
                <ValidationMessage For="() => categoria.Descricao" />
            </div>


            <div class="col-md-4">
                <label for="situacao" class="form-label">Situação</label>
                <InputSelect id="situacao" class="form-select" @bind-Value="categoria.Status">
                    <option value="">Selecione...</option>
                    <option value="Ativo">Ativo</option>
                    <option value="Novo">Novo</option>
                    <option value="Inativo">Inativo</option>
                </InputSelect>
                <ValidationMessage For="() => categoria.Status" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="codigo" class="form-label">Código</label>
                <InputText id="codigo" class="form-control" @bind-Value="categoria.Codigo" />
                <ValidationMessage For="() => categoria.Codigo" />
            </div>

            <div class="col-md-6">
                <label for="dataCadastro" class="form-label">Data de Cadastro</label>
                <InputDate id="dataCadastro" class="form-control" @bind-Value="categoria.DataCadastroCategoria" />
                <ValidationMessage For="() => categoria.DataCadastroCategoria" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Salvar
            </button>
            <a href="/categoria" class="btn btn-light border"> Cancelar </a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }
    protected override void OnInitialized()
    {
        if (Id.HasValue)
        {
            categoria = dao.BuscarPorId(Id.Value);

            if (categoria is null)
            {
                MensagemErro = "Categoria não encontrada.";
                categoria = new();
            }
        }


    }



    private Categoria categoria = new();
    private string? MensagemErro;

    private void Salvar()
    {
        try
        {
            if(Id.HasValue){
                dao.Atualizar(categoria);
                NavigationManager.NavigateTo("/categoria");
            }
            else
            {
                dao.Inserir(categoria);
                NavigationManager.NavigateTo("/categoria");
            }


        }
        catch (Exception ex)
        {
            MensagemErro = $"Não foi possível salvar a categoria. ({ex.Message})";
        }
    }
}
