@page "/homepage"

@rendermode InteractiveServer
@inject DashboardDAO DashboardDao

<PageTitle>Home - DeltaStock</PageTitle>

<section class="dashboard">
    <header class="dashboard-hero">
        <div>
            <span class="dashboard-eyebrow">Painel principal</span>
            <h1>Bem-vindo ao DeltaStock</h1>
            <p>Acompanhe estoque, movimentacoes e indicadores importantes em uma visao rapida.</p>
        </div>

        <a class="hero-action" href="/ProdutosAdicionar">Adicionar produto</a>
    </header>

    <section class="summary-grid" aria-label="Resumo do estoque">
        <article class="summary-card summary-blue">
            <span class="summary-label">Produtos</span>
            <strong>@Resumo.TotalProdutos</strong>
            <small>produtos cadastrados</small>
        </article>

        <article class="summary-card summary-green">
            <span class="summary-label">Entradas</span>
            <strong>@Resumo.EntradasMes</strong>
            <small>movimentações no mês</small>
        </article>

        <article class="summary-card summary-orange">
            <span class="summary-label">Saidas</span>
            <strong>@Resumo.SaidasMes</strong>
            <small>movimentações no mês</small>
        </article>

        <article class="summary-card summary-profit">
            <span class="summary-label">Lucro</span>
            <strong>@Resumo.LucroBruto.ToString("C")</strong>
            <small>lucro bruto acumulado</small>
        </article>
    </section>

    @if (MensagemErro is not null)
    {
        <div class="produto-feedback produto-error">@MensagemErro</div>
    }

    <section class="dashboard-columns">
        <article class="dashboard-panel">
            <div class="panel-title-row">
                <h2>Estoque baixo</h2>
                <span>@EstoqueBaixo.Count alerta@(EstoqueBaixo.Count == 1 ? "" : "s")</span>
            </div>

            <ul class="status-list">
                @if (EstoqueBaixo.Count == 0)
                {
                    <li><span>Nenhum produto com estoque baixo.</span></li>
                }
                else
                {
                    @foreach (var produto in EstoqueBaixo)
                    {
                        <li><strong>@produto.Nome</strong><span>@produto.Quantidade unidade@(produto.Quantidade == 1 ? "" : "s")</span></li>
                    }
                }
            </ul>
        </article>

        <article class="dashboard-panel">
            <div class="panel-title-row">
                <h2>Últimas movimentações</h2>
                <span>Registros recentes</span>
            </div>

            <ul class="movement-list">
                @if (Movimentacoes.Count == 0)
                {
                    <li><span>Nenhuma movimentação registrada.</span></li>
                }
                else
                {
                    @foreach (var movimentacao in Movimentacoes)
                    {
                        <li>
                            <span class="@(movimentacao.Tipo == "ENTRADA" || movimentacao.Tipo == "AJUSTE+" ? "movement-in" : "movement-out")">@Sinal(movimentacao.Tipo)@movimentacao.Quantidade</span>
                            <strong>@movimentacao.Produto</strong>
                        </li>
                    }
                }
            </ul>
        </article>
    </section>

    <section class="quick-actions" aria-label="Acesso rapido">
        <div class="panel-title-row">
            <h2>Acesso rapido</h2>
            <span>Atalhos</span>
        </div>

        <div class="quick-actions-grid">
            <a href="/ProdutosAdicionar">Adicionar produto</a>
            <a href="/ProdutosVisualizar">Ver produtos</a>
            <a href="/HistoricoVendas">Historico</a>
            <a href="/Relatorios">Relatorios</a>
        </div>
    </section>
</section>

@code {
    private DashboardResumo Resumo { get; set; } = new(0, 0, 0, 0);
    private List<ProdutoEstoqueBaixo> EstoqueBaixo { get; set; } = [];
    private List<MovimentacaoRecente> Movimentacoes { get; set; } = [];
    private string? MensagemErro { get; set; }

    protected override void OnInitialized()
    {
        try
        {
            Resumo = DashboardDao.ObterResumo(DateTime.Today);
            EstoqueBaixo = DashboardDao.ListarEstoqueBaixo();
            Movimentacoes = DashboardDao.ListarUltimasMovimentacoes();
        }
        catch (Exception ex)
        {
            MensagemErro = $"Não foi possível carregar os indicadores do painel. ({ex.Message})";
        }
    }

    private static string Sinal(string tipo) => tipo is "ENTRADA" or "AJUSTE+" ? "+" : "-";
}
