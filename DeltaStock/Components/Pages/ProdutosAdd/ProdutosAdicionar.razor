@page "/ProdutosAdicionar"

<h1>Adicionar Produto</h1>

<form>

    <label>Nome do Produto</label>
    <input type="text" />

    <label>Código</label>
    <input type="text" />

    <label>Fornecedor</label>
    <input type="text" />

    <label>Categoria</label>
    <input type="text" />

    <label>Preço de Compra</label>
    <input type="number" />

    <label>Preço de Venda</label>
    <input type="number" />

    <label>Quantidade</label>
    <input type="number" />

    <button type="submit">
        Salvar Produto
    </button>

</form>