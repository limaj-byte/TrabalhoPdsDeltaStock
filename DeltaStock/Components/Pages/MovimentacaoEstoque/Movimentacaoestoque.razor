@page "/MovimentacaoEstoque"

<PageTitle>Movimentação de Estoque</PageTitle>


<div class="movimentacao-page">


    <h1>📊 Movimentação de Estoque</h1>


    <div class="painel-container">


        <div class="mov-card entrada">

            <div class="mov-icon">
                📥
            </div>

            <div>

                <h2>Entradas</h2>

                <p>
                    Produtos adicionados ao estoque
                </p>

                <span>
                    +120 produtos
                </span>

            </div>


        </div>




        <div class="mov-card saida">

            <div class="mov-icon">
                📤
            </div>

            <div>

                <h2>Saídas</h2>

                <p>
                    Produtos retirados do estoque
                </p>

                <span>
                    -45 produtos
                </span>

            </div>


        </div>



        <div class="mov-card total">

            <div class="mov-icon">
                📦
            </div>

            <div>

                <h2>Total Movimentado</h2>

                <p>
                    Movimentações realizadas
                </p>

                <span>
                    165 registros
                </span>

            </div>


        </div>



    </div>



    <h2 class="titulo-historico">
        Histórico de Movimentações
    </h2>



    <div class="tabela-container">


        <table>


            <thead>

                <tr>

                    <th>Produto</th>

                    <th>Tipo</th>

                    <th>Quantidade</th>

                    <th>Data</th>

                </tr>

            </thead>



            <tbody>


                <tr>

                    <td>Mouse Gamer</td>

                    <td class="entrada-texto">
                        Entrada
                    </td>

                    <td>
                        +50
                    </td>

                    <td>
                        22/06/2026
                    </td>

                </tr>



                <tr>

                    <td>Teclado Mecânico</td>

                    <td class="saida-texto">
                        Saída
                    </td>

                    <td>
                        -10
                    </td>

                    <td>
                        21/06/2026
                    </td>

                </tr>



            </tbody>


        </table>


    </div>



</div>