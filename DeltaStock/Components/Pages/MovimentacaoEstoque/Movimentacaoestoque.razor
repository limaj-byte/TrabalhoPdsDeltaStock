@page "/MovimentacaoEstoque"
@rendermode InteractiveServer
@inject MovimentacaoDAO MovimentacaoDao

<PageTitle>Movimentação de Estoque</PageTitle>

<div class="movimentacao-page">

    <div class="movimentacao-header">
        <div>
            <h1>Movimentação de Estoque</h1>
            <p>Consulte as entradas e saídas realizadas no estoque.</p>
        </div>

        <span class="movimentacao-total">
            @Movimentacoes.Count movimentação@(Movimentacoes.Count == 1 ? "" : "ões")
        </span>
    </div>

    @if (Carregando)
    {
        <div class="movimentacao-feedback">
            Carregando movimentações...
        </div>
    }
    else if (MensagemErro is not null)
    {
        <div class="movimentacao-feedback movimentacao-error">
            <strong>Não foi possível carregar as movimentações.</strong>
            <span>@MensagemErro</span>
        </div>
    }
    else if (Movimentacoes.Count == 0)
    {
        <div class="movimentacao-feedback">
            Nenhuma movimentação registrada ainda.
        </div>
    }
    else
    {
        <div class="movimentacao-table-wrapper">

            <table class="movimentacao-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Saldo Anterior</th>
                        <th>Saldo Final</th>
                        <th>Origem</th>
                        <th>ID Documento</th>
                        <th>Motivo</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var movimentacao in Movimentacoes)
                    {
                        <tr>

                            <td>
                                @movimentacao.Id
                            </td>

                            <td>
                                @movimentacao.Data.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <span class="movimentacao-tipo">
                                    @movimentacao.Tipo
                                </span>
                            </td>

                            <td>
                                @movimentacao.Quantidade
                            </td>

                            <td>
                                @movimentacao.SaldoAnterior
                            </td>

                            <td>
                                <strong>@movimentacao.SaldoFinal</strong>
                            </td>

                            <td>
                                @movimentacao.Origem
                            </td>

                            <td>
                                @(movimentacao.Id_documento ?? "-")
                            </td>

                            <td>
                                @(movimentacao.Motivo ?? "-")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@code {

    private List<DeltaStock.Models.Movimentacao> Movimentacoes { get; set; } = [];

    private bool Carregando { get; set; } = true;

    private string? MensagemErro { get; set; }

    protected override Task OnInitializedAsync()
    {
        try
        {
            Movimentacoes = MovimentacaoDao.Listar();
        }
        catch (Exception ex)
        {
            MensagemErro = $"Confira se o MySQL está em execução e se os dados de conexão em appsettings.json estão corretos. ({ex.Message})";
        }
        finally
        {
            Carregando = false;
        }

        return Task.CompletedTask;
    }
}