@page "/Produtos"
@inject NavigationManager Nav

<PageTitle>Produtos</PageTitle>

<div class="produtos-page">

    <h1>📦 Gerenciamento de Produtos</h1>

    <div class="cards-container">

        <div class="produto-card"
             @onclick='() => Nav.NavigateTo("/ProdutosVisualizar")'>

            <div class="icone">👀</div>

            <h2>Visualizar Produtos</h2>

            <p>
                Consulte todos os produtos cadastrados no sistema.
            </p>

        </div>

        <div class="produto-card"
             @onclick='() => Nav.NavigateTo("/ProdutosAdicionar")'>

            <div class="icone">➕</div>

            <h2>Adicionar Produto</h2>

            <p>
                Cadastre novos produtos no estoque.
            </p>

        </div>

    </div>

</div>