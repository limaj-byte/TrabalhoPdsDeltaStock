@inherits LayoutComponentBase

<div class="app-shell">

    <aside class="sidebar">

        <div class="user-card">
            <div class="avatar">👤</div>
            <div class="user-name">Nome_Usuario</div>
        </div>

        <nav class="menu">
            <button>Produtos</button>
