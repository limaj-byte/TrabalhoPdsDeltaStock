@inherits LayoutComponentBase

<div class="app-shell">

    <aside class="sidebar">

        <div class="user-card" onclick="window.location.href='/'">
            <div class="avatar">👤</div>
            <div class="user-name">Nome_Usuario</div>
        </div>

        <nav class="menu">
            <button onclick="window.location.href='/Homepage'">Home Page</button>
            <button onclick="window.location.href = '/Produtos'">Produtos</button>
            <button onclick="window.location.href = '/MovimentacaoEstoque' ">Movimentação de Estoque</button>
            <button onclick="window.location.href = '/HistoricoVendas' ">Histórico </button>
            <button onclick ="window.location.href = '/Relatorios' ">Relatórios</button>
            <button onclick="window.location.href = '/Usuario' ">Usuários</button>
            <button onclick="window.location.href = '/Venda' ">Vendas</button>

        </nav>

        <div class="settings">
            ⚙️
        </div>

    </aside>

    <main class="main-content">
        @Body
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
